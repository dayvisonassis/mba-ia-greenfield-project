# Test environment — loaded by Jest via DOTENV_CONFIG_PATH (see package.json scripts).
# Committed on purpose: these are throwaway values for a local test database, no
# real secrets. The only value that matters is DB_NAME, which keeps the suite off
# the development database.

NODE_ENV=test
PORT=3000
APP_URL=http://localhost:3000

# Database — separate from development. Created and migrated by test/global-setup.ts.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube_test

# JWT
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-jwt-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Swagger
SWAGGER_ENABLED=true

# Object Storage (MinIO, S3-compatible) — same instance as development.
# Buckets are shared; tests namespace their objects by video id.
STORAGE_ENDPOINT_INTERNAL=http://minio:9000
# In development the public endpoint is localhost:9000, because the browser
# runs on the host. The test suite runs INSIDE the container, where localhost
# is the container itself — and SigV4 signs the Host header, so a presigned URL
# cannot simply be re-pointed at another host. host.docker.internal is the same
# MinIO reached from outside the Compose network, which is exactly what the
# public endpoint means, and it stays distinct from the internal one.
STORAGE_ENDPOINT_PUBLIC=http://host.docker.internal:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_BUCKET_VIDEOS=streamtube-videos
STORAGE_BUCKET_THUMBNAILS=streamtube-thumbnails

# Queue (Redis, backing BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
