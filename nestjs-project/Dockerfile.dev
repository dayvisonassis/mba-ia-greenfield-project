FROM node:25.6.0-slim

# ffmpeg brings ffprobe too. It is installed here, not only in the worker
# image, because the test suite runs inside THIS container and the project
# forbids mocking what Compose runs for real — without the binary the video
# processing tests could only mock child_process, and TD-09's acceptance rule
# (ffprobe is the authoritative gate) would be untestable where it matters.
RUN apt update && apt install -y procps curl ffmpeg

WORKDIR /home/node/app

# node_modules is a named volume (see compose.yaml). Docker seeds a fresh named
# volume from the image path, so the directory must already exist here owned by
# `node` — otherwise the volume is created as root and npm install fails EACCES.
RUN mkdir -p /home/node/app/node_modules && chown -R node:node /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 